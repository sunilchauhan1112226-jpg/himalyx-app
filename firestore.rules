rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sunilchauhan1112226@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Linked Apps logic
    match /linkedApps/{appId} {
      allow read: if true;
      allow create: if isAdmin() 
        && incoming().name is string && incoming().name.size() < 100
        && incoming().url is string && incoming().url.size() < 200
        && incoming().adminEmail == request.auth.token.email
        && incoming().createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Vault Items logic
    match /vaultItems/{itemId} {
      allow read: if true;
      allow create: if isAdmin()
        && incoming().title is string && incoming().title.size() < 100
        && incoming().type in ['Website', 'Repository', 'Design', 'Credentials']
        && incoming().linkedAppUrl is string
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'tags', 'icon'])
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // Projects logic
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tasks logic
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activities logic
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Revenue Data logic
    match /revenueData/{revenueId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
